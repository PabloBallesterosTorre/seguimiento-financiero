NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Registro por invitación. La service-role key SALTA todas las políticas RLS: no lleva
# prefijo NEXT_PUBLIC_ a propósito (así nunca llega al navegador) y solo se usa para
# crear la cuenta y leer/marcar la invitación que la autoriza.
# Supabase → Project Settings → API → Project API keys → `service_role`.
SUPABASE_SERVICE_ROLE_KEY=

# Emails que pueden crear invitaciones, separados por comas. Sin esto no hay
# administrador y la pestaña "Invitaciones" de Configuración no aparece para nadie.
ADMIN_EMAILS=

# Opcional: monitorización de errores en producción con Sentry (gratis hasta 5k
# errores/mes). Crea un proyecto en sentry.io y pega su DSN aquí — sin esto, la app
# funciona igual, solo que los errores no se reportan a Sentry (quedan en los logs
# de Vercel).
NEXT_PUBLIC_SENTRY_DSN=
# Opcionales, solo para que el build suba source maps a Sentry (stacktraces legibles):
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
